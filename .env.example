# NYX Panel — Environment Variables
# Copy this file to .env and fill in your values

# --- Сервер ---
SERVER_IP=your_server_ip
SERVER_DOMAIN=your.domain.com
SERVER_HOSTNAME=your-server-hostname

# --- Пользователи по умолчанию ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_admin_password

# --- VLESS+XHTTP+REALITY ---
# VLESS_HOST=your.domain.com
# VLESS_PORT=443
# VLESS_SNI=www.microsoft.com
# VLESS_PUBLIC_KEY=your_public_key
# VLESS_PRIVATE_KEY=your_private_key
# VLESS_SHORT_ID=your_short_id

# --- Hysteria 2 ---
# HY2_PORT=30000
# HY2_OBSF_PASSWORD=your_obsf_password
# HY2_SERVER_CONFIG=/etc/hysteria/config.yaml

# --- AmneziaWG ---
# AWG_PORT=39743
# AWG_SUBNET=10.9.9.0/24
# AWG_INTERFACE=awg0
# AWG_CONFIG=/etc/amnezia/amneziawg/awg0.conf

# --- NaiveProxy (Caddy) ---
# NAIVE_PORT=8443
# NAIVE_CONFIG=/etc/caddy/Caddyfile

# --- Mieru ---
# MIERU_IP=your_server_ip
# MIERU_PORTS=444-448
# MIERU_CONFIG=/etc/mita/server.json

# --- olcRTC ---
# OLRTC_USERS_FILE=/etc/olcrtc/users.json
# OLRTC_CONFIG=/root/.config/olcrtc/server.yaml
# OLRTC_ICE=ws://your.domain.com:30001/ice
# OLRTC_ROOM_URL=https://meet.example.com/pxy-your.domain
# OLRTC_CRYPTO_KEY=your_crypto_key_hex
# OLRTC_PORT=30001

# --- Xray ---
# XRAY_CONFIG=/usr/local/etc/xray/config.json
# XRAY_SERVICE=xray
# VLESS_USERS_FILE=/etc/xray/users.json

# --- Panel (Flask) ---
# PANEL_URL=https://your.domain.com:8443/panel/
# PANEL_SECRET_KEY=your_flask_secret_key
# CADDY_PANEL_AUTH=your_bcrypt_hash

# --- Пути ---
# PROXY_USERS_DIR=/root/proxy_users
# REGISTRY_FILE=/root/proxy_users/.registry
# CERTS_DIR=/etc/proxy-certs

# --- olcbox Android ---
# OLCBOX_APP_ID=org.olcbox.me
# OLCBOX_RELEASE_APK=./bin/olcbox-me-release.apk
# OLCBOX_DEBUG_APK=./bin/olcbox-claims-debug.apk

# --- olcRTC Windows бинарник ---
# OLRTC_WINDOWS_BIN=./bin/olcrtc-windows-amd64.exe
