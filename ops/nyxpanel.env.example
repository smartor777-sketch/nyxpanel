# /etc/nyxpanel/proxy.env — per-host settings for proxy_manager.sh
#
# Everything here used to be edited into the body of proxy_manager.sh on each
# machine, which is how four copies of it drifted apart and how a bad manual edit
# produced a corrupted line. Values are read with `set -a; . file`, so a missing
# required value must be caught explicitly.
#
# Install as: install -m 640 -o root -g nyxpanel /etc/nyxpanel/proxy.env

# ---- required -------------------------------------------------------------
# Paths. On this host hysteria keeps JSON, not YAML.
HY2_CONFIG=/etc/hysteria/config.json
AWG_CONFIG=/etc/amnezia/amneziawg/awg0.conf
NAIVE_CONFIG=/etc/sing-box/config.json
MIERU_CONFIG=/etc/mieru/config.json
TROJAN_USERS_FILE=/etc/sing-box/trojan_users.json
XRAY_CONFIG=/usr/local/etc/xray/config.json

# ---- server identity ------------------------------------------------------
SERVER_DOMAIN=vpn.example.com
VLESS_SNI=www.roblox.com

# Caddy stores its certificates under a per-user data dir; ask rather than guess.
# TROJAN_CERT=
# TROJAN_KEY=

# ---- secrets — never commit these ----------------------------------------
# They were in bin/proxy_manager.sh in git history; rotate them (see
# ops/ENVIRONMENT.md) and keep the new values only here.
VLESS_PUBLIC_KEY=
VLESS_SHORT_ID=

# ---- Xray runtime API (used to revoke clients without dropping sessions) ---
XRAY_API=127.0.0.1:10085
# Set to 1 once grpcurl is installed; without it revoke falls back to a config
# rewrite plus `systemctl restart xray`, which disconnects every VLESS client.
XRAY_GRPC_ENABLED=0

# ---- AmneziaWG client defaults --------------------------------------------
AWG_INTERFACE=awg0
AWG_SUBNET=10.9.9
# DNS handed to clients. H11: this used to be hardcoded to Yandex DNS in every
# generated config. Set to empty to leave the client's own DNS alone.
AWG_CLIENT_DNS=
AWG_CLIENT_DNS_IS_DOH=0
# H11/P2: 0.0.0.0/0 means every client byte goes through the server.
# Narrow it to keep LAN traffic local, quoting required because of the spaces:
#   AWG_ALLOWED_IPS="0.0.0.0/0, 192.168.0.0/16, 10.0.0.0/8, 127.0.0.0/8"
AWG_ALLOWED_IPS="0.0.0.0/0, ::/0"

# ---- logging --------------------------------------------------------------
SYNC_LOG=/var/log/nyxproxy/sync.log
