[Unit]
Description=Update container images for running compose stacks
Documentation=file:///usr/local/sbin/nyx-containers-update.sh
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nyx-containers-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
