[Unit]
Description=Update container images for running compose stacks
Documentation=file:///usr/local/sbin/nyx-containers-update.sh
Wants=network-online.target docker.service
After=network-online.target docker.service
# Wants, не Requires: рестарт docker.service не должен убивать pull/up.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nyx-containers-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
