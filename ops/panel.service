[Unit]
Description=nyxpanel web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nyxpanel
Group=nyxpanel
WorkingDirectory=/opt/nyxpanel/panel
EnvironmentFile=/etc/nyxpanel/panel.env
Environment=NYX_BASE_DIR=/var/lib/nyxpanel/users
Environment=NYX_DB_PATH=/var/lib/nyxpanel/panel.db
Environment=NYX_MANAGER=/opt/nyxpanel/bin/proxy_manager.sh
Environment=NYX_ENV=/etc/nyxpanel/proxy.env
Environment=NYX_PORT=5000
ExecStart=/usr/bin/python3 /opt/nyxpanel/panel/app.py
Restart=on-failure
RestartSec=5s

# The panel runs unprivileged. Anything that needs root goes through the
# short sudoers allowlist in /etc/sudoers.d/nyxpanel, which permits exactly
# bin/proxy_manager.sh and a fixed list of daemon restarts.
#
# NoNewPrivileges is deliberately absent. It blocks the setuid transition sudo
# relies on, so every user operation fails with
#   sudo: The "no new privileges" flag is set, which prevents sudo from running
#   as root.
# It can come back only together with removing sudo: the orchestrator would then
# have to be a root-side agent the panel signals, rather than one the panel
# invokes. That is the model in nyx-architecture-dev-reconcile.md.
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# --- filesystem ---------------------------------------------------------
#
# ProtectSystem=strict makes the whole filesystem read-only except the paths
# named below, and that mount namespace is inherited by every child process —
# including the ones sudo spawns. The orchestrator therefore runs as uid 0 and
# still cannot write the daemon configs: observed as
#   awg-add diag ... uid=0 writable=no
# with the append silently producing zero bytes while the panel reported success.
#
# So every path the orchestrator writes must be listed. Adding a protocol means
# adding its config directory here, or that protocol fails silently.
ReadWritePaths=/var/lib/nyxpanel
ReadWritePaths=/var/log/nyxpanel
ReadWritePaths=/etc/amnezia/amneziawg
ReadWritePaths=/etc/xray
ReadWritePaths=/etc/hysteria
ReadWritePaths=/etc/sing-box
ReadWritePaths=/etc/mita
ReadWritePaths=/etc/olcrtc
ReadWritePaths=/usr/local/etc/xray
ReadWritePaths=/var/lib/caddy
# olcRTC keeps its server config under root's home, so /root has to be reachable.
# read-only rather than true: true hides it entirely. This single directory is
# the only writable part of /root.
ReadWritePaths=/root/.config/olcrtc

ProtectSystem=strict
ProtectHome=read-only

ReadOnlyPaths=/etc/nyxpanel
ReadOnlyPaths=/opt/nyxpanel

[Install]
WantedBy=multi-user.target