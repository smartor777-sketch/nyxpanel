[Unit]
Description=Update Docker Engine from Docker CE repository
Documentation=file:///usr/local/sbin/nyx-docker-engine-update.sh
Wants=network-online.target docker.service
After=network-online.target docker.service
# Не Requires: обновление docker-ce перезапускает docker.service, а Requires
# остановил бы наш юнит и убил dpkg посреди настройки (проверено 10.11.2026).

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nyx-docker-engine-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
