[Unit]
Description=Update Docker Engine from Docker CE repository
Documentation=file:///usr/local/sbin/nyx-docker-engine-update.sh
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nyx-docker-engine-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
