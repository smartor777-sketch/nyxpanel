{
  "log": { "loglevel": "debug" },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth" }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "<YOUR_DOMAIN>",
            "port": 443,
            "users": [
              {
                "id": "6276429c-b022-4425-880f-81d04a45802c",
                "flow": "xtls-rprx-vision",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "www.microsoft.com",
          "fingerprint": "chrome",
          "shortId": "<YOUR_SHORT_ID>",
          "publicKey": "<YOUR_PUBLIC_KEY>"
        }
      }
    }
  ]
}
